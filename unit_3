<div class="head"><div><h2>Toffoli, SWAP, Reversibility, Interference &amp; Parallelism</h2><p>Multi-qubit gates, reversible computation and quantum phenomena.</p></div>
<a class="dl" download="Toffoli_SWAP_Reversible_Interference_Parallelism.pptx" href="data:application/vnd.openxmlformats-officedocument.presentationml.presentation;base64,">Download PPTX</a></div>
<div class="stage"><button class="nav prev" aria-label="Previous slide">‹</button><img alt="Slide 1" data-src='data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,|data:image/jpeg;base64,'><button class="nav next" aria-label="Next slide">›</button></div>
<div class="bar"><span class="ctr">1 / 16</span><button class="fs">Full screen</button></div>
<div class="thumbs"></div></section></main><footer>Use ← → keys to move between slides</footer>
<script>
const tabs=[...document.querySelectorAll('[role=tab]')],panes=[...document.querySelectorAll('section')];let cur=0;
panes.forEach(p=>{const d=p.querySelector('img').dataset.src.split('|');p._d=d;p._i=0;
const th=p.querySelector('.thumbs');d.forEach((s,k)=>{const t=new Image();t.src=s;t.loading='lazy';t.alt='Slide '+(k+1);t.onclick=()=>go(p,k);th.appendChild(t)});
p.querySelector('.prev').onclick=()=>go(p,p._i-1);p.querySelector('.next').onclick=()=>go(p,p._i+1);
p.querySelector('.fs').onclick=()=>{const s=p.querySelector('.stage');(document.fullscreenElement?document.exitFullscreen():s.requestFullscreen&&s.requestFullscreen())};go(p,0)});
function go(p,i){const n=p._d.length;i=(i+n)%n;p._i=i;const im=p.querySelector('.stage img');im.src=p._d[i];im.alt='Slide '+(i+1);
p.querySelector('.ctr').textContent=(i+1)+' / '+n;[...p.querySelectorAll('.thumbs img')].forEach((t,k)=>t.classList.toggle('on',k===i));
const on=p.querySelector('.thumbs img.on');if(on)on.scrollIntoView({block:'nearest',inline:'center'})}
function show(k){cur=k;tabs.forEach((t,j)=>{t.setAttribute('aria-selected',j===k);panes[j].hidden=j!==k});try{localStorage.setItem('Unit_3_Material',k)}catch(e){}}
tabs.forEach((t,k)=>t.onclick=()=>show(k));
document.addEventListener('keydown',e=>{if(e.key==='ArrowRight')go(panes[cur],panes[cur]._i+1);if(e.key==='ArrowLeft')go(panes[cur],panes[cur]._i-1)});
try{const s=+localStorage.getItem('Unit_3_Material');if(s>0&&s<tabs.length)show(s)}catch(e){}
</script></body></html>
