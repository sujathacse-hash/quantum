<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Unit 3 Material</title>
<style>
:root{--bg:#f6f7fb;--card:#fff;--ink:#16192b;--mut:#5b6078;--acc:#4338ca;--acc2:#eef0ff;--bd:#e2e4f0}
@media(prefers-color-scheme:dark){:root{--bg:#0f1220;--card:#181c30;--ink:#eceefb;--mut:#9aa0bd;--acc:#8b93ff;--acc2:#232849;--bd:#2a2f4d}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.5 system-ui,-apple-system,Segoe UI,Roboto,sans-serif}
header{padding:32px 16px 8px;max-width:1100px;margin:auto}header small{color:var(--acc);font-weight:600;letter-spacing:.06em;text-transform:uppercase}
h1{margin:4px 0 0;font-size:clamp(1.7rem,4vw,2.4rem)}main{max-width:1100px;margin:auto;padding:16px}
[role=tablist]{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px}
[role=tab]{flex:1 0 auto;min-width:150px;text-align:left;border:1px solid var(--bd);background:var(--card);color:var(--ink);border-radius:12px;padding:10px 14px;font:inherit;font-weight:600;cursor:pointer}
[role=tab] span{display:block;font-weight:400;font-size:.8rem;color:var(--mut)}
[role=tab][aria-selected=true]{background:var(--acc);color:#fff;border-color:var(--acc)}[role=tab][aria-selected=true] span{color:#e0e2ff}
section{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:16px;margin-top:10px}
.head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}h2{margin:0;font-size:1.2rem}.head p{margin:2px 0 0;color:var(--mut);font-size:.92rem}
.dl{background:var(--acc2);color:var(--acc);padding:8px 14px;border-radius:10px;text-decoration:none;font-weight:600;font-size:.9rem}
.stage{position:relative;margin-top:14px;background:#000;border-radius:10px;overflow:hidden}.stage img{display:block;width:100%;height:auto}
.nav{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;border:0;background:rgba(0,0,0,.55);color:#fff;font-size:26px;cursor:pointer}.prev{left:8px}.next{right:8px}
.bar{display:flex;justify-content:space-between;align-items:center;margin-top:10px;color:var(--mut);font-size:.9rem}.fs{border:1px solid var(--bd);background:none;color:var(--ink);border-radius:8px;padding:4px 10px;cursor:pointer}
.thumbs{display:flex;gap:6px;overflow-x:auto;margin-top:10px;padding-bottom:6px}.thumbs img{height:60px;border-radius:5px;border:2px solid transparent;cursor:pointer;opacity:.7}.thumbs img.on{border-color:var(--acc);opacity:1}
footer{text-align:center;color:var(--mut);font-size:.8rem;padding:20px}
</style></head><body><header><small>Quantum Computing · Search & Multi-Qubit Gates</small><h1>Unit 3 Material</h1></header><main>
<div role="tablist" aria-label="Unit 3 Material"><button role="tab" id="t0" aria-controls="p0" aria-selected="true" data-i="0">Grover Search<span>18 slides</span></button><button role="tab" id="t1" aria-controls="p1" aria-selected="false" data-i="1">Search Applications<span>18 slides</span></button><button role="tab" id="t2" aria-controls="p2" aria-selected="false" data-i="2">Toffoli & SWAP<span>16 slides</span></button></div><section role="tabpanel" id="p0" aria-labelledby="t0"  data-n="18">
<div class="head"><div><h2>Quantum Search Algorithms: Grover</h2><p>Oracle, amplitude amplification, geometric picture and iteration count.</p></div>
<a class="dl" download="Quantum_Search_Algorithms_Grover.pptx" href="data:application/vnd.openxmlformats-officedocument.presentationml.presentation;base64,">Download PPTX</a></div>
